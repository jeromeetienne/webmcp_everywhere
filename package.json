{
	"name": "webmcp_everywhere",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"description": "A community-maintained library of WebMCP adapters that register tools into sites that have not shipped their own.",
	"keywords": [
		"webmcp",
		"model context protocol",
		"chrome extension",
		"browser agent",
		"site adapter"
	],
	"homepage": "https://github.com/jeromeetienne/webmcp_everywhere#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeromeetienne/webmcp_everywhere.git"
	},
	"bugs": {
		"url": "https://github.com/jeromeetienne/webmcp_everywhere/issues"
	},
	"scripts": {
		"build": "node tools/build_extension.ts",
		"package:release": "node tools/package_release.ts",
		"pack:npm": "npm run build && npm run package:release && npm pack --pack-destination build ./build/release",
		"sync:adapters": "node tools/sync_adapter_registry.ts",
		"new-adapter": "node tools/new_adapter.ts",
		"load-adapter": "node tools/load_adapter.ts",
		"unload-adapter": "node tools/unload_adapter.ts",
		"test": "node --test --test-concurrency=1",
		"test:visible": "WEBMCP_EVERYWHERE_CHROME_VISIBILITY=visible node --test --test-concurrency=1",
		"test:no_browser": "node --test --test-concurrency=1 tests/adapter_registry_sync.test.ts tests/endpoint_file.test.ts tests/native_host_install.test.ts tests/npm_package.test.ts tests/source_boundary.test.ts tests/workspace_packages.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:versions": "node tools/version_agreement.ts",
		"chrome": "node tools/launch_chrome.ts",
		"grant": "node tools/grant_acting.ts",
		"install:host": "node tools/install_native_host_entry.ts",
		"uninstall:host": "node tools/uninstall_native_host_entry.ts",
		"bridge": "node tests/devtools_protocol_bridge/webmcp_bridge.ts",
		"mcp:inspector:start": "npx @modelcontextprotocol/inspector --web --transport http --server-url $(jq -r .url ~/.webmcp_everywhere/endpoint.json) --header \"Authorization: Bearer $(cat ~/.webmcp_everywhere/token)\"",
		"mcp:inspector:stop": "pkill -f \"mcp-inspector|@modelcontextprotocol/inspector\" && echo \"mcp:inspector was stopped\" || echo \"mcp:inspector was not running, nothing to stop\""
	},
	"devDependencies": {
		"@webmcp_everywhere/adapter_format": "0.1.0",
		"@webmcp_everywhere/adapter_toolkit": "0.1.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@types/chrome": "0.2.6",
		"@types/node": "26.2.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"zod": "3.25.76"
	}
}
