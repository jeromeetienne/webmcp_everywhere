{
	"name": "webmcp_everywhere",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A community-maintained library of WebMCP adapters that register tools into sites that have not shipped their own.",
	"scripts": {
		"build": "node tools/build_extension.mjs",
		"chrome": "node tools/launch_chrome.mjs",
		"verify": "node tools/verify_milestones.mjs",
		"bridge": "node src/bridge/webmcp_bridge.mjs",
		"typecheck": "tsc --noEmit",
		"verify:bridge": "node tools/verify_bridge.mjs",
		"grant": "node tools/grant_acting.mjs",
		"verify:host": "node tools/verify_native_host.mjs",
		"install:host": "node tools/install_native_host.mjs",
		"verify:injection": "node tools/verify_injection_defence.mjs",
		"mcp:inspector:start": "npx @modelcontextprotocol/inspector --web --transport http --server-url $(jq -r .url ~/.webmcp_everywhere/endpoint.json) --header \"Authorization: Bearer $(jq -r .token ~/.webmcp_everywhere/endpoint.json)\"",
		"mcp:inspector:stop": "pkill -f \"mcp-inspector|@modelcontextprotocol/inspector\" && echo \"mcp:inspector was stopped\" || echo \"mcp:inspector was not running, nothing to stop\""
	},
	"dependencies": {
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"@types/chrome": "0.2.6",
		"@types/node": "26.2.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2"
	}
}
