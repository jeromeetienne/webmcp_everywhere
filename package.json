{
	"name": "webmcp_everywhere",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.18.0"
	},
	"type": "module",
	"description": "A community-maintained library of WebMCP adapters that register tools into sites that have not shipped their own.",
	"scripts": {
		"build": "node tools/build_extension.ts",
		"test": "node --test --test-concurrency=1",
		"test:visible": "WEBMCP_EVERYWHERE_CHROME_VISIBILITY=visible node --test --test-concurrency=1",
		"chrome": "node tools/launch_chrome.ts",
		"verify": "node --test tests/verify_milestones.test.ts",
		"bridge": "node tests/devtools_protocol_bridge/webmcp_bridge.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify:bridge": "node --test tests/verify_bridge.test.ts",
		"verify:caniuse": "node --test tests/verify_caniuse.test.ts",
		"grant": "node tools/grant_acting.ts",
		"verify:host": "node --test tests/verify_native_host.test.ts",
		"install:host": "node tools/install_native_host.ts",
		"verify:injection": "node --test tests/verify_injection_defence.test.ts",
		"verify:boundary": "node --test tests/verify_source_boundary.test.ts",
		"mcp:inspector:start": "npx @modelcontextprotocol/inspector --web --transport http --server-url $(jq -r .url ~/.webmcp_everywhere/endpoint.json) --header \"Authorization: Bearer $(jq -r .token ~/.webmcp_everywhere/endpoint.json)\"",
		"mcp:inspector:stop": "pkill -f \"mcp-inspector|@modelcontextprotocol/inspector\" && echo \"mcp:inspector was stopped\" || echo \"mcp:inspector was not running, nothing to stop\""
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"@types/chrome": "0.2.6",
		"@types/node": "26.2.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"zod": "3.25.76"
	}
}
