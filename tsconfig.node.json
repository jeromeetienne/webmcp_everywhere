{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"types": ["node"]
	},
	"include": [
		"src/adapter_format/**/*.ts",
		"src/native_messaging_host/**/*.ts",
		"tests/**/*.ts",
		"tools/**/*.ts"
	],
	"exclude": [
		"src/adapter_format/webmcp_globals.d.ts",
		"tools/adapter_validation/**/*.ts"
	]
}
