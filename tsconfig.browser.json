{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "chrome"]
	},
	"include": [
		"src/adapter_format/**/*.ts",
		"src/site_adapters/**/*.ts",
		"src/chrome_extension/**/*.ts",
		"tools/adapter_validation/**/*.ts"
	]
}
